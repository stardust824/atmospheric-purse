void setup() {
  // sets up the mode for the pins
  pinMode(button, INPUT);
  pinMode(buzzer, OUTPUT);
  // enable pull up resistor
  digitalWrite(button, HIGH);
  Wire1.setSDA(2);
  Wire1.setSCL(3);
  Wire1.begin();
  display.init();
  Serial.begin(9600);
  display.backlight();

  WiFi.begin(ssid, pass);

  // while trying to connect to WiFi, it prints dots for debugging
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }

  Serial.println("connected!");
  Serial.println(WiFi.localIP());

  // for debugging
  //while (1) {
    //if (Serial.available()) {
      //if (Serial.read() == 'a') {
        //break;
      //}
    //}
  //}

  Serial.println("START");

// sets up https 
  https.setInsecure(); 
  https.useHTTP10(true);
  // connects to weather server. Hardcoded
  if (https.begin("https://api.weather.gov/gridpoints/SEW/131,122/forecast")) {
    // times out unless this is included
    https.addHeader("Accept", "*/*");
    // need this to connect and get real data
    https.setUserAgent("Stwawbewwy");

    Serial.println("Connected to server");
    // checks if data was recieved
    if (https.GET() > 0) {
      // parses response
      DynamicJsonDocument doc(2048);
      deserializeJson(doc, https.getStream());
      // Read values
      temp1 = doc["properties"]["periods"][0]["temperature"].as<long>();
      rain_percent = doc["properties"]["periods"][0]["probabilityOfPrecipitation"]["value"].as<long>();
      temp2 = doc["properties"]["periods"][1]["temperature"].as<long>();

      // set high and low
      if (temp1 >= temp2) {
        high = temp1;
        low = temp2;
      } else {
        high = temp2;
        low = temp1;
      }

      // weather logic
      if (low <= 32 && rain_percent >= 50) {
        snowy = 1;
      } else if (rain_percent >= 50){
        rainy = 1;
      } else {
        sunny = 1;
      }
      // debugging prints
      Serial.printf("High: %d \n", high);
      Serial.printf("Low: %d\n", low);
      Serial.printf("Rain percent: %d \n", rain_percent);
      Serial.printf("Sunny? %d \n", sunny);
      Serial.printf("Rainy? %d \n", rainy);
      Serial.printf("Snowy? %d \n", snowy);

      display.setBacklight(0);
      display.print("High: ");
      display.print(high);
      display.print("\n Low: ");
      display.print(low);

    } else {
      Serial.println("Can't get data");
    }
    https.end();

  } else {
    Serial.println("Web connect error");
  }
}

void loop() {
  
  if (digitalRead(button) == 0) {
    if (sunny == 1) {
      play_sunshine();
    } else if (rainy == 1) {
      play_rain();
    } else {
      play_snow;
    }
  }



